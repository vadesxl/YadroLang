# std/математика.яд — быстрая ИИ-математика YadroLang
# Наивные циклы намеренно: LLVM -O2 + loop-vectorize развернёт их в SIMD.

функ релу(х) {
    если х < 0 {
        вернуть 0
    }
    вернуть х
}

функ скалярное(а, б, длина) {
    пусть сумма = 0
    пусть и = 0
    пока и < длина {
        сумма = сумма + а * б
        и = и + 1
    }
    вернуть сумма
}
