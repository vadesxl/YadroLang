# Test case 26: Return from loop with secret-dependent counter
# Expected: COMPILE ERROR - counter inherits loop control taint

функ старт() требует [ДоступСети] {
    пусть count = 0
    пока count < 10 {
        если среда.секрет() > 0 {
            count = count + 1
        }
    }
    вернуть сеть.отправить(count)
}
