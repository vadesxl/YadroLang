# Безопасный неявный поток: условие санитизировано перед ветвлением.
# Этический анализатор должен ПРОПУСТИТЬ это.

функ безопасная_проверка() требует [ДоступСети] {
    пусть профиль = пользователь.данные()
    пусть чисто = анонимизировать(профиль)
    если чисто > 0 {
        сеть.отправить(1)
    }
    вернуть 0
}

функ старт() {
    вернуть безопасная_проверка()
}
