# Регресс на ревью Codex: заражение через ВОЗВРАТ функции.
# читать() сама возвращает личные данные (источник).
# слить() льёт результат читать() в сеть -> анализатор обязан поймать,
# хотя у читать() нет заражённых аргументов.

функ читать() {
    вернуть пользователь.данные()
}

функ слить() требует [ДоступСети] {
    вернуть сеть.отправить(читать())
}

функ старт() { вернуть 0 }
