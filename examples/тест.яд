# Пример YadroLang v1.1 - компилируется в нативный бинарь и печатает вывод

функ удвоить(х) {
    вернуть х * 2
}

функ факториал(н) {
    пусть итог = 1
    пусть и = 1
    пока и < н + 1 {
        итог = итог * и
        и = и + 1
    }
    вернуть итог
}

функ старт() {
    печать(удвоить(21))
    вернуть факториал(5)
}
