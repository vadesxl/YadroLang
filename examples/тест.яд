# Пример YadroLang — канонический синтаксис v1.0

функ удвоить(х) {
    вернуть х * 2
}

функ факториал(н) {
    пусть итог = 1
    пусть и = 1
    пока и < н + 1 {
        итог = итог * и
        и = и + 1
    }
    вернуть итог
}

функ старт() {
    пусть а = удвоить(10)
    если а > 15 {
        вернуть факториал(5)
    } иначе {
        вернуть 777
    }
}
