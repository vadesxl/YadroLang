# YadroLang v1.2 - нативный бинарь со строками и числами

функ удвоить(х) {
    вернуть х * 2
}

функ факториал(н) {
    пусть итог = 1
    пусть и = 1
    пока и < н + 1 {
        итог = итог * и
        и = и + 1
    }
    вернуть итог
}

функ старт() {
    печать("Привет, YadroLang!")
    печать(удвоить(21))
    вернуть факториал(5)
}
