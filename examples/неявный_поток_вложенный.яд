# Вложенный неявный поток: двойное ветвление на зараженных условиях.
# Оба уровня должны быть пойманы.

функ глубокий_шпион() требует [ДоступСети] {
    пусть возраст = пользователь.данные()
    если возраст > 18 {
        пусть счет = пользователь.данные()
        если счет > 100 {
            сеть.отправить(42)
        }
    }
    вернуть 0
}

функ старт() {
    вернуть глубокий_шпион()
}
