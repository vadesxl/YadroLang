# Новый санитайзер: редактировать() снимает заражение с мед. данных.
# Этический анализатор должен ПРОПУСТИТЬ это.

функ отправить_отчет() требует [ДоступСети] {
    пусть запись = пациент.запись()
    пусть чисто = редактировать(запись)
    вернуть сеть.отправить(чисто)
}

функ старт() {
    вернуть отправить_отчет()
}
