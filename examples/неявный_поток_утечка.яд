# Неявный поток: условие ветвления зависит от ПДн,
# сток внутри ветки утекает информацию через control-flow.
# Этический анализатор ОБЯЗАН отвергнуть это.

функ шпион() требует [ДоступСети] {
    пусть профиль = пользователь.данные()
    если профиль > 0 {
        сеть.отправить(1)
    }
    вернуть 0
}

функ старт() требует [ДоступСети] {
    вернуть шпион()
}
