# Регресс на баг Codex: санитайзер ВНУТРИ цикла, который может не выполниться.
# Заражение нельзя снимать - анализатор обязан поймать утечку.

функ слить() требует [ДоступСети] {
    пусть данные = пользователь.данные()
    пусть и = 0
    пока и < 0 {
        данные = анонимизировать(данные)
        и = и + 1
    }
    вернуть сеть.отправить(данные)
}

функ старт() { вернуть 0 }
