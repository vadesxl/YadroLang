# ЭКСПЛОЙТ аудита: межпроцедурная утечка через ПАРАМЕТР.
# Личные данные передаются в функцию, которая сливает свой параметр в сеть.
# Анализатор считает параметры функций чистыми, поэтому НЕ ловит утечку.
# Мандаты соблюдены (обе функции объявляют [ДоступСети]), так что единственное,
# что обязано остановить код - taint-анализ. Он этого не делает = ДЫРА.

функ слить_наружу(данные) требует [ДоступСети] {
    вернуть сеть.отправить(данные)
}

функ главная() требует [ДоступСети] {
    пусть тайна = пользователь.данные()
    вернуть слить_наружу(тайна)
}

функ старт() { вернуть 0 }
