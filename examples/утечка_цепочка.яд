# Регресс на ревью Codex: цепочка присваиваний в цикле.
# a=b; b=c; c=источник(); сток(a) - после фикспойнта 'a' заражается,
# и анализатор ОБЯЗАН поймать утечку. Двух проходов мало - нужен фикспойнт.

функ слить() требует [ДоступСети] {
    пусть a = 0
    пусть b = 0
    пусть c = 0
    пусть и = 0
    пока и < 5 {
        a = b
        b = c
        c = пользователь.данные()
        сеть.отправить(a)
        и = и + 1
    }
    вернуть 0
}

функ старт() { вернуть 0 }
