# Новый санитайзер: зашифровать() снимает заражение с финансовых данных.
# Этический анализатор должен ПРОПУСТИТЬ это.

функ безопасный_платеж() требует [ДоступСети] {
    пусть карта = платеж.карта()
    пусть безопасно = зашифровать(карта)
    вернуть сеть.отправить(безопасно)
}

функ старт() {
    вернуть безопасный_платеж()
}
