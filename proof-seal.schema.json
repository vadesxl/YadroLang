{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:yadrolang:schema:proof-seal:1.0","title":"Yadro Proof Seal 1.0 design schema","type":"object","additionalProperties":false,
 "required":["schema","trust","compiler","subject","analysis","seal_sha256"],
 "properties":{
  "schema":{"const":"yadro-proof-seal-1.0"},
  "trust":{"type":"object","additionalProperties":false,"required":["mode","authenticity"],"properties":{"mode":{"const":"unsigned"},"authenticity":{"const":"not-provided"}}},
  "compiler":{"type":"object","additionalProperties":false,"required":["name","version","frontend","semantic_surface","evidence_algorithm","llvm_compatibility"],"properties":{"name":{"const":"yadro-guard"},"version":{"type":"string","minLength":1,"maxLength":64},"frontend":{"enum":["ru","en"]},"semantic_surface":{"type":"string","minLength":1,"maxLength":32},"evidence_algorithm":{"const":"yadro-evidence-1.0"},"llvm_compatibility":{"type":"string","minLength":1,"maxLength":64}}},
  "subject":{"type":"object","additionalProperties":false,"required":["policy_schema_version","llvm_normalization_version","source_sha256","policy_sha256","llvm_sha256","artifact_sha256","target_triple","artifact_kind"],"properties":{"policy_schema_version":{"const":"yadro-policy-1.0"},"llvm_normalization_version":{"const":"yadro-llvm-normalization-1.0"},"source_sha256":{"$ref":"#/$defs/sha256"},"policy_sha256":{"$ref":"#/$defs/sha256"},"llvm_sha256":{"$ref":"#/$defs/sha256"},"artifact_sha256":{"$ref":"#/$defs/sha256"},"target_triple":{"type":"string","minLength":1,"maxLength":128},"artifact_kind":{"enum":["elf-object","macho-object","coff-object"]}}},
  "analysis":{"type":"object","additionalProperties":false,"required":["entry_points","call_sites","assumptions","fixpoint"],"properties":{"entry_points":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/name"}},"call_sites":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/callSite"}},"assumptions":{"type":"array","maxItems":2000,"items":{"$ref":"#/$defs/assumption"}},"fixpoint":{"$ref":"#/$defs/fixpoint"}}},
  "seal_sha256":{"$ref":"#/$defs/sha256"}
 },
 "$defs":{
  "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"safeInteger":{"type":"integer","minimum":0,"maximum":9007199254740991},"name":{"type":"string","minLength":1,"maxLength":256},"smallSet":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/name"}},"digestSet":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}},
  "span":{"type":"object","additionalProperties":false,"required":["module_path","start_byte","end_byte","ordinal"],"properties":{"module_path":{"type":"string","minLength":1,"maxLength":512,"pattern":"^(?!/)(?![A-Za-z]:)(?!//)[^\\\\]+$"},"start_byte":{"$ref":"#/$defs/safeInteger"},"end_byte":{"$ref":"#/$defs/safeInteger"},"ordinal":{"$ref":"#/$defs/safeInteger"}}},
  "callSite":{"type":"object","additionalProperties":false,"required":["id","module_id","semantic_kind","caller","callee","span","required_capabilities","declared_capabilities","incoming_labels","outgoing_labels","sanitizers","declassified_labels","policy_rules","implicit_labels","assumption_ids","reachable_entries","status"],"properties":{"id":{"$ref":"#/$defs/sha256"},"module_id":{"$ref":"#/$defs/sha256"},"semantic_kind":{"const":"call"},"caller":{"$ref":"#/$defs/name"},"callee":{"$ref":"#/$defs/name"},"span":{"$ref":"#/$defs/span"},"required_capabilities":{"$ref":"#/$defs/smallSet"},"declared_capabilities":{"$ref":"#/$defs/smallSet"},"incoming_labels":{"$ref":"#/$defs/smallSet"},"outgoing_labels":{"$ref":"#/$defs/smallSet"},"sanitizers":{"$ref":"#/$defs/smallSet"},"declassified_labels":{"$ref":"#/$defs/smallSet"},"policy_rules":{"$ref":"#/$defs/smallSet"},"implicit_labels":{"$ref":"#/$defs/smallSet"},"assumption_ids":{"$ref":"#/$defs/digestSet"},"reachable_entries":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/name"}},"status":{"const":"allowed"}}},
  "assumption":{"type":"object","additionalProperties":false,"required":["id","symbol","abi_signature","capability","taint_transform","trusted_sanitizer","lifetime","no_retain","implementation_sha256"],"properties":{"id":{"$ref":"#/$defs/sha256"},"symbol":{"$ref":"#/$defs/name"},"abi_signature":{"type":"string","minLength":1,"maxLength":512},"capability":{"type":["string","null"],"maxLength":256},"taint_transform":{"type":"string","minLength":1,"maxLength":512},"trusted_sanitizer":{"type":"boolean"},"lifetime":{"type":"string","minLength":1,"maxLength":512},"no_retain":{"type":"boolean"},"implementation_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]}}},
  "fixpoint":{"type":"object","additionalProperties":false,"required":["algorithm","lattice_labels","updates","bound"],"properties":{"algorithm":{"const":"bounded-monotone-1.0"},"lattice_labels":{"$ref":"#/$defs/smallSet"},"updates":{"$ref":"#/$defs/safeInteger"},"bound":{"type":"integer","minimum":1,"maximum":9007199254740991}}}
 }
}
